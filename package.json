{
  "name": "chatterlayer",
  "productName": "ChatterLayer",
  "version": "0.2.0",
  "description": "Live, colour-coded Discord voice captions for OBS. Free, offline, fully local.",
  "main": "src/main/main.js",
  "author": "ruptz",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/ruptz/ChatterLayer",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruptz/ChatterLayer.git"
  },
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/setup.js",
    "icon": "node scripts/make-icon.js",
    "test:vosk": "node scripts/test-vosk.js",
    "test:stt": "node scripts/test-stt.js",
    "bench": "node --expose-gc scripts/bench.js",
    "engine:headless": "node src/engine/engine.js --headless",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "selftest": "node scripts/selftest.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "extract-zip": "^2.0.1",
    "koffi": "^3.1.2",
    "libsodium-wrappers": "^0.8.4",
    "onnxruntime-node": "^1.23.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.9",
    "fast-uri": "^3.1.5",
    "js-yaml@4": "^4.3.1"
  }
}
