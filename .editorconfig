# https://editorconfig.org — keeps editors producing the same bytes Git expects
# (LF, see .gitattributes). Matches the existing style in src/: 2-space indent,
# single quotes, trailing newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = false
