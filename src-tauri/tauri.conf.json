{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatterLayer",
  "version": "0.5.1",
  "identifier": "com.ruptz.chatterlayer",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "resources": {
      "../vendor/runtime/vosk/*": "vosk/",
      "../vendor/runtime/onnxruntime/*": "onnxruntime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
